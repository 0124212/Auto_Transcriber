# Auto Transcriber — API keys (optional)
# Local Whisper needs NO key. Fill these in only for cloud engines.
# Get a FREE Groq key: https://console.groq.com/keys
# Get an OpenAI key (paid): https://platform.openai.com/api-keys
#
# You can also paste keys directly into the web UI — they land here automatically.

GROQ_API_KEY=
OPENAI_API_KEY=

# Done-ping (optional) — phone notification when a job finishes.
# Self-hosted: NTFY_URL=http://your-server:8080
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
